# Stallion Match - Environment Configuration Example
# Copy this file to Server/.env and fill in values for your environment.

# Server
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info
PUBLIC_BASE_URL=http://127.0.0.1:8080

# PostgreSQL Database
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=stallion_match
DATABASE_TEST_NAME=stallion_match_test

# Authentication (JWT)
# Generate a strong secret: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-byte-secret-in-local-env
JWT_ACCESS_EXPIRATION_SECONDS=900
JWT_REFRESH_EXPIRATION_DAYS=30
APPLE_BUNDLE_ID=com.stallionmatch.app

# Storage Service ("local" or "s3")
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./Public/uploads
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=stallion-match-photos
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Apple Push Notification service (APNs)
APNS_DRIVER=stub
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.stallionmatch.app
APNS_PRIVATE_KEY_PATH=
APNS_ENVIRONMENT=sandbox
